# Optional live workspace only. The fixture demo needs no environment file.
NEAR_NETWORK=testnet
NEAR_CONTRACT_ID=
NEAR_VERIFIER_ACCOUNT_ID=
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
MODEL_PROVIDER=gemini
MODEL_NAME=
MODEL_API_KEY=

# Use a Gemini Free Tier project or an NVIDIA Free Endpoint; no automatic provider substitution.
MODEL_TIMEOUT_MS=15000
MODEL_MAX_TOKENS=2048
MODEL_MAX_ATTEMPTS=2
# Optional: MODEL_DB_PATH (defaults to artifacts/local/model.sqlite)

# Local Supabase CA certificate path; obtain from your project dashboard.
DATABASE_CA_PATH=

# Explicit new-order verification profile and isolated operator evidence run.
NEAR_VERIFICATION_MODE=
NEAR_WORK_RUN=stage6-success-final
GEMINI_MODEL=
GEMINI_API_KEY=
